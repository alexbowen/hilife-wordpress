!wp-content/themes/twentytwentyfive/templates/single-blog.php
!wp-content/themes/twentytwentyfive/templates/single-dj.php
!wp-content/themes/twentytwentyfive/templates/single-music-theme.php
!wp-content/themes/twentytwentyfive/templates/taxonomy-location.php
!wp-content/themes/twentytwentyfive/templates/taxonomy-occasion.php
